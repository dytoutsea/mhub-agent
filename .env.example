# Development placeholders only. Generate independent values for each local run.
MHUB_AGENT_RELAY_CONTROL_URL=ws://127.0.0.1:8443/agent/v1/control
MHUB_AGENT_PROXY_ID=cpx_replace_me
MHUB_AGENT_SESSION_TICKET=replace_me

# Never enable outside an isolated local integration test.
MHUB_AGENT_ALLOW_PRIVATE_TARGETS=false

# Public mobile build configuration. These values are visible in the app bundle;
# never put credentials, tickets, private keys, or internal SOCKS URIs here.
EXPO_PUBLIC_MHUB_AGENT_ACTIVATION_API_URL=https://api.example.test/agent-api/v1/activations:exchange
EXPO_PUBLIC_MHUB_RELAY_CONTROL_URL=wss://relay.example.test/agent/v1/control
