{
  "name": "@mhub/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "npm run build && cross-env MHUB_RENDERER_URL=http://localhost:8081 electron .",
    "package": "npm run build && electron-builder",
    "package:unsigned": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "package:unsigned:mac:universal": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --universal --publish never",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "cross-env": "10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "tsup": "8.5.1"
  },
  "build": {
    "appId": "com.mhub.agent",
    "productName": "黄雀云Agent",
    "asar": true,
    "icon": "assets/mhub-agent.png",
    "artifactName": "mhub-agent-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mobile/dist",
        "to": "renderer"
      },
      {
        "from": "assets/mhub-agent.png",
        "to": "tray/mhub-agent.png"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/mhub-agent.png",
      "target": [
        "nsis"
      ]
    }
  }
}
